# 앱 접속(RLS 적용, 비-superuser)
DATABASE_URL=postgres://mansun_app:mansun_app@localhost:5432/mansun
# 마이그레이션/시드 전용(테이블 소유자)
DATABASE_OWNER_URL=postgres://mansun_owner:mansun_owner@localhost:5432/mansun
# 세션 JWT 서명 키 (32자 이상)
SESSION_SECRET=dev-only-change-me-dev-only-change-me-0000
# 스케줄러 tick (true/false)
SCHEDULER_ENABLED=true
# 업로드 저장 경로
UPLOAD_DIR=./uploads
# dev 편의: OTP 코드를 화면에 노출
SHOW_DEV_OTP=true
APP_TZ=Asia/Seoul
