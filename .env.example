MANSUN_DATABASE_URL=postgres://localhost:5432/mansun_market
AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_ORIGIN=http://localhost:3005
UPLOAD_DIR=./data/uploads
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM=
# Development only; never enabled in production or on public hosts.
DEV_SMS_PREVIEW=false

# Runtime tunnel origin file (managed by scripts/tunnel.mjs)
PUBLIC_ORIGIN_FILE=
# Set before opening signup to real users
SERVICE_OPERATOR_NAME=
SERVICE_OPERATOR_CONTACT=

# Kakao Developers > Platform key > REST API key (server only)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# Register APP_ORIGIN/api/auth/kakao/callback as the exact redirect URI.
